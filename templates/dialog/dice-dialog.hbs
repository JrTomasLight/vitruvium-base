<div class="vitruvium dice-dialog">
  <div class="form-group">
    <label for="{{id}}-dice">{{localize "VITRUVIUM.Dice.Count"}}</label>
    <div class="form-fields">
      <select id="{{id}}-dice" name="dice">
        {{selectOptions diceOptions selected=dice}}
      </select>
    </div>
    <p class="hint">{{localize "VITRUVIUM.Dice.Hint"}}</p>
  </div>
</div>
