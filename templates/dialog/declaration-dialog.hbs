<div class="vitruvium declaration-dialog">
  <div class="form-group stacked">
    <label for="{{id}}-action">{{localize "VITRUVIUM.Declaration.Action"}}</label>
    <textarea id="{{id}}-action" name="action" required autofocus
              placeholder="{{localize 'VITRUVIUM.Declaration.ActionPlaceholder'}}"></textarea>
  </div>

  <div class="form-group stacked">
    <label for="{{id}}-goal">{{localize "VITRUVIUM.Declaration.Goal"}}</label>
    <input id="{{id}}-goal" type="text" name="goal"
           placeholder="{{localize 'VITRUVIUM.Declaration.GoalPlaceholder'}}">
    <p class="hint">{{localize "VITRUVIUM.Declaration.GoalHint"}}</p>
  </div>
</div>
