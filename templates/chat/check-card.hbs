<div class="vitruvium chat-card check-card {{#if success}}success{{else}}failure{{/if}}">
  <header class="check-header">
    <span class="check-label">{{label}}</span>
    <span class="check-meta">
      {{localize "VITRUVIUM.Check.PoolSize" count=pool}}{{#if modeLabel}} · {{modeLabel}}{{/if}}
    </span>
  </header>

  <ol class="check-attempts">
    {{#each attempts as |attempt|}}
    <li class="check-attempt {{#if attempt.chosen}}chosen{{/if}}">
      <ol class="check-dice">
        {{#each attempt.dice as |die|}}
        <li class="vit-face successes-{{die.successes}}" data-tooltip="{{die.label}}" aria-label="{{die.label}}">
          {{#each die.marks}}<span class="vit-mark" inert></span>{{/each}}
        </li>
        {{/each}}
      </ol>
      <span class="attempt-total">{{attempt.successes}}</span>
    </li>
    {{/each}}
  </ol>
  {{#if multiple}}<p class="check-note">{{localize chosenHint}}</p>{{/if}}

  <div class="check-result">
    <span class="check-successes">
      {{localize "VITRUVIUM.Check.SuccessesOf" successes=successes difficulty=difficulty}}
    </span>
    <span class="check-outcome">
      {{#if success}}{{localize "VITRUVIUM.Check.Success"}}{{else}}{{localize "VITRUVIUM.Check.Failure"}}{{/if}}
    </span>
  </div>
  {{#unless success}}<p class="check-note">{{localize "VITRUVIUM.Check.PartialHint"}}</p>{{/unless}}
</div>
