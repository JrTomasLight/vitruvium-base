<nav class="sheet-tabs tabs" data-group="primary" aria-label="{{localize 'VITRUVIUM.Sheet.Tabs'}}">
  {{#each tabs as |tab|}}
  <a class="item {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <i class="{{tab.icon}}" inert></i>
    <span>{{localize tab.label}}</span>
  </a>
  {{/each}}
</nav>
